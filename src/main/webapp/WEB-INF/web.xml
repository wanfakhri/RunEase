<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

  <display-name>RunEase - Running Event Management System</display-name>

  <!-- Creates the schema and demonstration data on first start, including
       when the WAR is deployed to a standalone servlet container. -->
  <listener>
    <listener-class>my.uitm.runease.web.AppContextListener</listener-class>
  </listener>

  <description>
    RunEase is a Jakarta EE 10 running-event management platform. Participants
    discover races and manage entries, organizers publish events and results,
    and administrators moderate the platform.
  </description>

  <!-- ==================================================================
       Filter chain. Order matters:
       encoding -> security headers -> flash -> CSRF -> route guard.
       ================================================================== -->
  <filter>
    <filter-name>EncodingFilter</filter-name>
    <filter-class>my.uitm.runease.web.EncodingFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>EncodingFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <filter>
    <filter-name>SecurityHeadersFilter</filter-name>
    <filter-class>my.uitm.runease.web.SecurityHeadersFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>SecurityHeadersFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <filter>
    <filter-name>FlashFilter</filter-name>
    <filter-class>my.uitm.runease.web.FlashFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>FlashFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <filter>
    <filter-name>CsrfFilter</filter-name>
    <filter-class>my.uitm.runease.web.CsrfFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>CsrfFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <filter>
    <filter-name>AuthFilter</filter-name>
    <filter-class>my.uitm.runease.web.AuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <!-- ==================================================================
       Session hygiene
       ================================================================== -->
  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
    </cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>

  <!-- ==================================================================
       Friendly error surfaces
       ================================================================== -->
  <error-page>
    <error-code>403</error-code>
    <location>/WEB-INF/views/errors/error.jsp</location>
  </error-page>
  <error-page>
    <error-code>404</error-code>
    <location>/WEB-INF/views/errors/error.jsp</location>
  </error-page>
  <error-page>
    <error-code>500</error-code>
    <location>/WEB-INF/views/errors/error.jsp</location>
  </error-page>
  <error-page>
    <exception-type>java.lang.Throwable</exception-type>
    <location>/WEB-INF/views/errors/error.jsp</location>
  </error-page>

  <!-- ==================================================================
       JSP defaults
       ================================================================== -->
  <jsp-config>
    <jsp-property-group>
      <url-pattern>*.jsp</url-pattern>
      <url-pattern>*.jspf</url-pattern>
      <page-encoding>UTF-8</page-encoding>
      <default-content-type>text/html</default-content-type>
      <trim-directive-whitespaces>true</trim-directive-whitespaces>
    </jsp-property-group>
  </jsp-config>

</web-app>
